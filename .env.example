# ==============================================================================
# TELEGRAM MTPROTO CREDENTIALS (Obtain from https://my.telegram.org)
# ==============================================================================
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef0123456789abcdef0123456789
TELEGRAM_SESSION_NAME=sunnatbek_userbot
TELEGRAM_PHONE_NUMBER=+998901234567

# ==============================================================================
# OPENAI API CONFIGURATION
# ==============================================================================
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_WHISPER_MODEL=whisper-1

# ==============================================================================
# SUPABASE POSTGRESQL + PGVECTOR CONFIGURATION
# ==============================================================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_TABLE_NAME=chat_memory
SIMILARITY_THRESHOLD=0.65
MEMORY_TOP_K=5
MAX_RECENT_MESSAGES=8

# ==============================================================================
# EXECUTIVE ASSISTANT SETTINGS & PERSONA
# ==============================================================================
OWNER_NAME=Sunnatbek
ASSISTANT_NAME="Sunnatbek's Executive Assistant"
TIMEZONE=Asia/Tashkent

# Whitelist: Comma-separated Telegram User IDs allowed to trigger AI responses (leave empty to allow all private contacts)
WHITELIST_USER_IDS=

# Blacklist: Comma-separated Telegram User IDs ignored completely (spammers, bots)
BLACKLIST_USER_IDS=

# Group & Channel settings
RESPOND_TO_GROUPS=False
RESPOND_TO_CHANNELS=False
RESPOND_TO_SAVED_MESSAGES=True
ALLOWED_GROUP_IDS=

# Prefix added to AI assistant replies (leave empty for seamless stealth replies as yourself)
REPLY_PREFIX=

# Mark incoming messages as read automatically
AUTO_READ_MESSAGES=True

# Reply delay seconds (0 = immediate reply when offline)
REPLY_DELAY_SECONDS=0
# Only reply when owner is offline. When owner enters Telegram, AI stops automatically.
ONLY_REPLY_WHEN_OFFLINE=True
OWNER_CUSTOM_INSTRUCTIONS=

# ==============================================================================
# MEDIA PROCESSING SETTINGS
# ==============================================================================
TEMP_DIR=temp_media
MAX_VIDEO_FRAMES=8
FRAME_SAMPLE_INTERVAL_SEC=1.5
MAX_AUDIO_SIZE_MB=25
MAX_VIDEO_SIZE_MB=50

# ==============================================================================
# 24/7 KEEP-ALIVE & HEARTBEAT SETTINGS (Server uxlab qolmasligi uchun)
# ==============================================================================
PORT=8080
HEARTBEAT_INTERVAL_MINUTES=13
SEND_TELEGRAM_HEARTBEAT=True
# Render yoki serveringizning tashqi domeni (masalan: https://botingiz.onrender.com)
PING_URL=

